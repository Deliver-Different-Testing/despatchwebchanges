echo "Running tests before push..."

# husky runs this hook via `sh -e`, so a bare failing command aborts the script
# immediately. Every check below is therefore written as `if ! cmd; then ... fi`
# -- a command in an `if` condition is exempt from `set -e`, which is what lets
# the integration step stay advisory and lets the blocking steps print their
# own message before exiting.

# Run ESLint
echo "Running ESLint..."
if ! npm run lint; then
    echo "ESLint failed. Push aborted."
    exit 1
fi

# Run TypeScript type-check
echo "Running TypeScript type-check..."
if ! npm run type-check; then
    echo "TypeScript type-check failed. Push aborted."
    exit 1
fi

# Run .NET tests. xUnit v3 builds a self-contained runner and the .NET 10 SDK no
# longer supports the VSTest path `dotnet test` takes, so run the test project
# directly -- same command CI uses.
echo "Running .NET tests..."
if ! dotnet run --project DespatchWeb.Tests; then
    echo ".NET tests failed. Push aborted."
    exit 1
fi

# Run Jest unit tests
if ! npx jest --silent; then
    echo "Jest unit tests failed. Push aborted."
    exit 1
fi

# Run Jest integration tests using dedicated integration config
echo "Running integration tests..."
if ! npx jest --silent --config jest.integration.config.js; then
    echo "⚠ Some integration tests failed (non-blocking). Review output above."
fi

echo "All required tests passed!"
