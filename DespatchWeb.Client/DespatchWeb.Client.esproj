<Project Sdk="Microsoft.Build.NoTargets/3.7.0">
  <!-- Solution node only. DespatchWeb.csproj's NpmBuild target runs npm install/build, so building the solution does not build the client twice. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <None Include="**/*" Exclude="node_modules/**;dist/**;bin/**;obj/**;.tsbuildinfo/**" />
  </ItemGroup>
</Project>
