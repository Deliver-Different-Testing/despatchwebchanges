  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "type-check": "tsc -b",
    "validate": "concurrently -n tsc,lint --kill-others-on-fail \"tsc -b\" \"oxlint src/ vite.config.ts --report-unused-disable-directives-severity=error\"",
    "lint": "oxlint src/ vite.config.ts --report-unused-disable-directives-severity=error",
    "lint:fix": "oxlint src/ vite.config.ts --report-unused-disable-directives-severity=error --fix",
    "test": "vitest --run --project unit",
    "test:unit": "vitest --run --project unit",
    "test:integration": "vitest --run --project integration",
    "test:watch": "vitest",
    "test:coverage": "vitest --run --project unit --coverage",
    "prepare": "cd .. && husky"
