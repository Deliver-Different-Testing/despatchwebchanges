<Project Sdk="Microsoft.NET.Sdk.Web">
  <Target Name="NpmBuild" BeforeTargets="Build" Condition="'$(CI)' != 'true'">
    <Exec Command="npm run build" WorkingDirectory="$(ProjectDir)" />
  </Target>
  <!--
    esbuild's metafile is several MB of build introspection (it enumerates every source
    path in the app). It is written into wwwroot/dist so the analyze script can find it
    next to the bundles it describes, but it has no business in the published image.
    dist is generated during the build, after content globbing, so it is removed from the
    output rather than excluded from an item group.
  -->
  <Target Name="RemoveBuildMetafileFromPublish" AfterTargets="Publish">
    <Delete Files="$(PublishDir)wwwroot\dist\meta.json" />
  </Target>

  <PropertyGroup Label="Globals">
      <Nullable>disable</Nullable>
      <!--
        The SDK's static-web-asset compression only pays off with MapStaticAssets, which
        this app doesn't use — it serves wwwroot through UseStaticFiles. Left on, publish
        spends time producing .br/.gz for everything under wwwroot (including the 14 MB of
        esbuild sourcemaps) that nothing ever reads. build.ts already pre-compresses the
        bundles that matter, and PrecompressedStaticFilesMiddleware serves those.
      -->
      <CompressionEnabled>false</CompressionEnabled>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="DespatchWeb.Tests" />
  </ItemGroup>
  <PropertyGroup Label="Configuration" Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <TypeScriptTarget>ES2021</TypeScriptTarget>
  </PropertyGroup>

  <PropertyGroup Label="Configuration" Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <TypeScriptTarget>ES2021</TypeScriptTarget>
  </PropertyGroup>

  <!-- Exclude test project from compilation -->
  <ItemGroup>
    <Compile Remove="DespatchWeb.Tests\**" />
    <Content Remove="DespatchWeb.Tests\**" />
    <None Remove="DespatchWeb.Tests\**" />
    <EmbeddedResource Remove="DespatchWeb.Tests\**" />
    <Compile Remove="EntityClasses\DespatchContext.JobItemTypes.cs" />
  </ItemGroup>

	<PropertyGroup>
		<!-- Makes the TypeScript compilation task a no-op -->
		<TypeScriptCompileBlocked>true</TypeScriptCompileBlocked>
	</PropertyGroup>
	
