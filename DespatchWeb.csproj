<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- The SPA lives in DespatchWeb.Client (Vite); its .esproj builds wwwroot/dist as part of the solution. -->

  <PropertyGroup Label="Globals">
      <SpaRoot>DespatchWeb.Client</SpaRoot>
      <SpaProxyServerUrl>http://despatch.local.deliverdifferent.com:5174</SpaProxyServerUrl>
      <SpaProxyLaunchCommand>npm run dev</SpaProxyLaunchCommand>
      <Nullable>disable</Nullable>
      <!-- Sourcemaps are never fetched by users; skip compressing them at publish. -->
      <CompressionExcludePatterns>$(CompressionExcludePatterns);**/*.map</CompressionExcludePatterns>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="DespatchWeb.Tests" />
  </ItemGroup>

  <!-- Build the SPA before this project scans wwwroot/dist. The slnx BuildDependency only orders a
       solution build; DespatchWeb.Tests builds this project through its own ProjectReference, which
       bypassed it and let Vite's emptyOutDir delete dist mid-scan. Skipped under CI (the SPA is built
       separately there) and when the client folder isn't present (Docker restores this csproj alone). -->
  <ItemGroup Condition="'$(CI)' != 'true' and Exists('DespatchWeb.Client/DespatchWeb.Client.esproj')">
    <ProjectReference Include="DespatchWeb.Client/DespatchWeb.Client.esproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <!-- Vite names bundles by content hash and empties dist on every build, so a wwwroot/dist list
       taken when the project is evaluated goes stale as soon as the SPA build runs ("No file exists
       for the asset ..."). List dist when static web assets are resolved instead, after that build. -->
  <ItemGroup>
    <Content Remove="wwwroot\dist\**" />
  </ItemGroup>
  <Target Name="IncludeSpaDistAsContent" BeforeTargets="ResolveProjectStaticWebAssets">
    <ItemGroup>
      <Content Include="wwwroot\dist\**" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    </ItemGroup>
  </Target>
  <PropertyGroup Label="Configuration" Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <TypeScriptTarget>ES2021</TypeScriptTarget>
  </PropertyGroup>

  <PropertyGroup Label="Configuration" Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <TypeScriptTarget>ES2021</TypeScriptTarget>
  </PropertyGroup>

  <!-- Exclude test project from compilation -->
  <ItemGroup>
    <Compile Remove="DespatchWeb.Tests\**" />
    <Compile Remove="DespatchWeb.Client\**" />
    <Content Remove="DespatchWeb.Client\**" />
    <None Remove="DespatchWeb.Client\**" />
    <EmbeddedResource Remove="DespatchWeb.Client\**" />
    <Content Remove="DespatchWeb.Tests\**" />
    <None Remove="DespatchWeb.Tests\**" />
    <EmbeddedResource Remove="DespatchWeb.Tests\**" />
    <Compile Remove="EntityClasses\DespatchContext.JobItemTypes.cs" />
  </ItemGroup>

	<PropertyGroup>
		<!-- Makes the TypeScript compilation task a no-op -->
		<TypeScriptCompileBlocked>true</TypeScriptCompileBlocked>
	</PropertyGroup>
	
  <ItemGroup>
    <Content Remove="bundleconfig.json" />
    <Content Remove="compilerconfig.json" />

  </ItemGroup>
  <ItemGroup>
    <Content Update="appsettings.json">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Content>
    <Content Update="appsettings.Development.json">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <None Include="efpt.config.json.user" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Amazon.AspNetCore.DataProtection.SSM" />
    <PackageReference Include="Anthropic" />
    <PackageReference Include="AspNetCore.HealthChecks.SqlServer" />
    <PackageReference Include="AWSSDK.S3" />
    <PackageReference Include="AWSSDK.SecurityToken" />
    <PackageReference Include="AWSSDK.SSO" />
    <PackageReference Include="JetBrains.Annotations" />
    <PackageReference Include="Magick.NET-Q8-AnyCPU" />
    <PackageReference Include="DeliverDifferent.AgentAccess" />
    <PackageReference Include="DeliverDifferentReporting" />
    <PackageReference Include="ExcelDataReader" />
    <PackageReference Include="PdfSharp" />
    <PackageReference Include="ExcelDataReader.DataSet" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" />
    <PackageReference Include="Microsoft.AspNetCore.SpaProxy" />
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="System.Linq.Async" />
    <!-- Pins the transitive copy from Microsoft.Data.SqlClient past GHSA-846f-f764-76mx / GHSA-2fmv-rv2c-59x7. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
    <PackageReference Include="System.Linq.Dynamic.Core" />
    <PackageReference Include="TimeZoneConverter" />
  </ItemGroup>
  <ItemGroup>
    <AdditionalFiles Include="BannedSymbols.txt" />
  </ItemGroup>
</Project>
