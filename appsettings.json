{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "AWS": {
    "Profile": "default",
    "Region": "ap-southeast-2"
  },
  "AllowedHosts": "*",
  "Anthropic": {
    "Model": "claude-sonnet-4-20250514",
    "MaxTokensPerRequest": 4096,
    "MaxTokensPerSummary": 1024,
    "RateLimitPerUserPerMinute": 20,
    "RateLimitPerTenantPerMinute": 100,
    "EnableAiFeatures": true
  }
}
