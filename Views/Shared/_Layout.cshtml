@using System.IO
@using System.Text.Json
@{
    Dictionary<string, string> manifest;
    try
    {
        var manifestPath = System.IO.Path.Combine(Directory.GetCurrentDirectory(), "wwwroot", "dist", "manifest.json");
        var manifestContent = await File.ReadAllTextAsync(manifestPath);
        manifest = JsonSerializer.Deserialize<Dictionary<string, string>>(manifestContent);
    }
    catch (Exception ex)
    {
        manifest = new Dictionary<string, string>
        {
            ["vendor-core.js"] = "vendor-core.js",
            ["vendor-plugins.js"] = "vendor-plugins.js",
            ["app.js"] = "app.js",
            ["vendor-core.css"] = "vendor-core.css",
            ["vendor-plugins.css"] = "vendor-plugins.css",
            ["app.css"] = "app.css"
        };

        await Console.Error.WriteLineAsync($"Error reading manifest: {ex.Message}");
    }

    var vendorCoreJs = manifest["vendor-core.js"];
    var vendorPluginsJs = manifest["vendor-plugins.js"];
    var appBundleFile = manifest["app.js"];
    var vendorCoreCss = manifest.GetValueOrDefault("vendor-core.css", "");
    var vendorPluginsCss = manifest.GetValueOrDefault("vendor-plugins.css", "");
    var appStylesFile = manifest["app.css"];
}

<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <title>Deliver Different - Dispatch</title>

    <link id="favicon" rel="shortcut icon" type="image/x-icon" href="dispmain.ico">

    <style>
        .app-loader {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: #fafafa;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            z-index: 9999;
            transition: opacity 0.3s ease-out;
        }

        .loader-content {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 24px;
        }

        .loader-icon {
            font-size: 48px;
            color: rgba(0, 0, 0, 0.54);
        }

        .loading-text {
            font-family: 'Satoshi', 'Roboto', sans-serif;
            font-size: 14px;
            font-weight: 500;
            color: rgba(0, 0, 0, 0.6);
            letter-spacing: 0.1px;
        }

        .linear-progress {
            width: 200px;
            height: 4px;
            background-color: rgba(0, 0, 0, 0.08);
            border-radius: 4px;
            overflow: hidden;
            position: relative;
        }

        .linear-progress-bar {
            position: absolute;
            top: 0;
            left: 0;
            height: 100%;
            width: 40%;
            border-radius: 4px;
            background-color: var(--theme-primary, #2196f3);
            animation: indeterminate 1.8s cubic-bezier(0.65, 0.815, 0.735, 0.395) infinite;
        }

        @@keyframes indeterminate {
            0%   { left: -40%; width: 40%; }
            60%  { left: 100%; width: 40%; }
            100% { left: 100%; width: 40%; }
        }
    </style>

    <script>
        function initMap() {
            console.log("Maps Loaded");
        }
    </script>

    <link rel="stylesheet" href="https://ajax.googleapis.com/ajax/libs/angular_material/1.2.5/angular-material.min.css">
    <link rel="stylesheet" href="https://js.api.here.com/v3/3.1/mapsjs-ui.css" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap" />
    <link href="https://api.fontshare.com/v2/css?f[]=satoshi@300,400,500,600,700&display=swap" rel="stylesheet">

    @{
        var vendorReactJs = manifest.GetValueOrDefault("vendor-react.js", "vendor-react.js");
    }
    <link rel="preload" href="/dist/manifest.json" as="fetch" crossorigin />
    <link rel="preload" href="/dist/@vendorReactJs" as="script" />

    @if (!string.IsNullOrEmpty(vendorCoreCss))
    {
        <link rel="stylesheet" href="/dist/@vendorCoreCss" />
    }
    @if (!string.IsNullOrEmpty(vendorPluginsCss))
    {
        <link rel="stylesheet" href="/dist/@vendorPluginsCss" />
    }
    <link rel="stylesheet" href="/dist/@appStylesFile" />
</head>

<body ng-app="uDispatch">
    <!-- Full Screen Loader -->
    <div class="app-loader" id="appLoader">
        <div class="loader-content">
            <span class="material-symbols-outlined loader-icon">local_shipping</span>
            <div class="linear-progress">
                <div class="linear-progress-bar"></div>
            </div>
            <div class="loading-text">Loading...</div>
        </div>
    </div>

    @RenderBody()

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.5.1/jquery.min.js"
            integrity="sha512-bLT0Qm9VnAYZDflyKcBaQ2gg0hSYNQrJ8RilYldYQ1FxQYoCLtUjuuRuZo+fjqhx/qtq/1itJ0C2ejDxltZVFg=="
            crossorigin="anonymous" referrerpolicy="no-referrer" defer></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jqueryui/1.12.1/jquery-ui.min.js"
            integrity="sha512-uto9mlQzrs59VwILcLiRYeLKPPbS/bT71da/OEBYEwcdNUk8jYIy+D176RYoop1Da+f9mvkYrmj5MCLZWEtQuA=="
            crossorigin="anonymous" referrerpolicy="no-referrer" defer></script>

    <script src="https://js.api.here.com/v3/3.1/mapsjs-core.js" defer></script>
    <script src="https://js.api.here.com/v3/3.1/mapsjs-core-legacy.js" defer></script>
    <script src="https://js.api.here.com/v3/3.1/mapsjs-service.js" defer></script>
    <script src="https://js.api.here.com/v3/3.1/mapsjs-ui.js" defer></script>
    <script src="https://js.api.here.com/v3/3.1/mapsjs-mapevents.js" defer></script>
    <script src="https://js.api.here.com/v3/3.1/mapsjs-harp.js" defer></script>

    <script src="/dist/@vendorCoreJs" defer></script>
    <script src="/dist/@vendorPluginsJs" defer></script>
    <script src="/dist/@appBundleFile" defer></script>

    <script>
        (() => {
            let resourcesLoaded = false;
            let angularReady = false;

            setTimeout(() => {
                hideLoader();
            }, 15000);

            function hideLoader() {
                const loaderElement = document.getElementById('appLoader');
                if (loaderElement && !loaderElement.classList.contains('hidden')) {
                    loaderElement.classList.add('hidden');

                    setTimeout(() => {
                        if (loaderElement.parentNode) {
                            loaderElement.parentNode.removeChild(loaderElement);
                        }
                    }, 300);
                }
            }

            window.addEventListener('load', () => {
                resourcesLoaded = true;
                if (angularReady) {
                    hideLoader();
                }
            });

            // Deferred scripts execute before DOMContentLoaded, so angular is available here
            document.addEventListener('DOMContentLoaded', () => {
                window.angular.module('uDispatch').run(['$timeout', $timeout => {
                    $timeout(() => {
                        angularReady = true;
                        if (resourcesLoaded) {
                            hideLoader();
                        }
                    });
                }]);
            });
        })();
    </script>
</body>
</html>
