@using System.IO
@using System.Text.Json
@{
    Dictionary<string, string> manifest;
    try
    {
        var manifestPath = System.IO.Path.Combine(Directory.GetCurrentDirectory(), "wwwroot", "dist", "manifest.json");
        var manifestContent = await File.ReadAllTextAsync(manifestPath);
        manifest = JsonSerializer.Deserialize<Dictionary<string, string>>(manifestContent);
    }
    catch (Exception ex)
    {
        manifest = new Dictionary<string, string>
        {
            ["vendor.js"] = "vendor.js",
            ["app.js"] = "app.js",
            ["vendor.css"] = "vendor.css",
            ["app.css"] = "app.css"
        };

        await Console.Error.WriteLineAsync($"Error reading manifest: {ex.Message}");
    }

    var vendorBundleFile = manifest["vendor.js"];
    var appBundleFile = manifest["app.js"];
    var vendorStylesFile = manifest["vendor.css"];
    var appStylesFile = manifest["app.css"];
}

<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <title>Deliver Different - Dispatch</title>
    <link id="favicon" rel="shortcut icon" type="image/x-icon" href="dispmain.ico">

    <style>
        .app-loader {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: #f8f9fa;
            display: flex;
            justify-content: center;
            align-items: center;
            z-index: 9999;
            transition: opacity 0.5s ease-out;
        }

        .app-loader.hidden {
            opacity: 0;
            pointer-events: none;
        }

        .spinner {
            width: 70px;
            height: 70px;
            border-radius: 50%;
            border: 6px solid rgba(0, 123, 255, 0.1);
            border-top-color: #3EAFC2;
            animation: spin 1s infinite linear;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
        }

        .loader-icon {
            position: absolute;
            font-size: 30px;
            color: #3EAFC2;
            z-index: 1;
        }

        .loading-text {
            margin-top: 20px;
            font-size: 16px;
            color: #6c757d;
        }

        @@keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }
    </style>

    <script>
        function initMap() {
            console.log("Maps Loaded");
        }
    </script>

    <link rel="stylesheet" href="https://ajax.googleapis.com/ajax/libs/angular_material/1.2.5/angular-material.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@3.4.1/dist/css/bootstrap.min.css"
          integrity="sha384-HSMxcRTRxnN+Bdg0JdbxYKrThecOKuH5zCYotlSAcp1+c8xmyTe9GYg1l9a69psu" crossorigin="anonymous">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="/dist/@vendorStylesFile" />
    <link rel="stylesheet" href="/dist/@appStylesFile" />
</head>

<body ng-app="uDispatch">
    <!-- Full Screen Loader -->
    <div class="app-loader" id="appLoader">
        <div class="loader-content">
            <div class="spinner">
                <span class="material-symbols-outlined loader-icon">local_shipping</span>
            </div>
            <div class="loading-text">Loading Dispatch...</div>
        </div>
    </div>

    @RenderBody()

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.5.1/jquery.min.js"
            integrity="sha512-bLT0Qm9VnAYZDflyKcBaQ2gg0hSYNQrJ8RilYldYQ1FxQYoCLtUjuuRuZo+fjqhx/qtq/1itJ0C2ejDxltZVFg=="
            crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jqueryui/1.12.1/jquery-ui.min.js"
            integrity="sha512-uto9mlQzrs59VwILcLiRYeLKPPbS/bT71da/OEBYEwcdNUk8jYIy+D176RYoop1Da+f9mvkYrmj5MCLZWEtQuA=="
            crossorigin="anonymous" referrerpolicy="no-referrer"></script>

    <script src="https://js.api.here.com/v3/3.1/mapsjs-core.js"></script>
    <script src="https://js.api.here.com/v3/3.1/mapsjs-core-legacy.js"></script>
    <script src="https://js.api.here.com/v3/3.1/mapsjs-service.js"></script>
    <script src="https://js.api.here.com/v3/3.1/mapsjs-ui.js"></script>
    <script src="https://js.api.here.com/v3/3.1/mapsjs-mapevents.js"></script>
    <script src="https://js.api.here.com/v3/3.1/mapsjs-harp.js"></script>

    <script src="/dist/@vendorBundleFile"></script>
    <script src="/dist/@appBundleFile"></script>

    <script>
        (function() {
            var resourcesLoaded = false;
            var angularReady = false;


            setTimeout(function() {
                hideLoader();
            }, 15000);

            function hideLoader() {
                var loaderElement = document.getElementById('appLoader');
                if (loaderElement && !loaderElement.classList.contains('hidden')) {
                    loaderElement.classList.add('hidden');

                    setTimeout(function() {
                        if (loaderElement.parentNode) {
                            loaderElement.parentNode.removeChild(loaderElement);
                        }
                    }, 500);
                }
            }

            window.addEventListener('load', function() {
                resourcesLoaded = true;
                if (angularReady) {
                    hideLoader();
                }
            });

            window.angular.module('uDispatch').run(['$timeout', function($timeout) {
                $timeout(function() {
                    angularReady = true;
                    if (resourcesLoaded) {
                        hideLoader();
                    }
                });
            }]);
        })();
    </script>
</body>
</html>
