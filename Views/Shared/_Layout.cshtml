@using System.Text.Json
@{
    Dictionary<string, string> manifest;
    try
    {
        var manifestPath = System.IO.Path.Combine(Directory.GetCurrentDirectory(), "wwwroot", "dist", "manifest.json");
        var manifestContent = await File.ReadAllTextAsync(manifestPath);
        manifest = JsonSerializer.Deserialize<Dictionary<string, string>>(manifestContent);
    }
    catch (Exception ex)
    {
        manifest = new Dictionary<string, string>
        {
            ["vendor-core.js"] = "vendor-core.js",
            ["vendor-plugins.js"] = "vendor-plugins.js",
            ["vendor-react.js"] = "vendor-react.js",
            ["app.js"] = "app.js",
            ["vendor-core.css"] = "vendor-core.css",
            ["vendor-plugins.css"] = "vendor-plugins.css",
            ["vendor-react.css"] = "vendor-react.css",
            ["app.css"] = "app.css"
        };

        await Console.Error.WriteLineAsync($"Error reading manifest: {ex.Message}");
    }

    var vendorCoreJs = manifest.GetValueOrDefault("vendor-core.js", "");
    var vendorPluginsJs = manifest.GetValueOrDefault("vendor-plugins.js", "");
    var vendorReactJs = manifest.GetValueOrDefault("vendor-react.js", "");
    var appBundleFile = manifest.GetValueOrDefault("app.js", "");
    var vendorCoreCss = manifest.GetValueOrDefault("vendor-core.css", "");
    var vendorPluginsCss = manifest.GetValueOrDefault("vendor-plugins.css", "");
    var vendorReactCss = manifest.GetValueOrDefault("vendor-react.css", "");
    var appStylesFile = manifest.GetValueOrDefault("app.css", "");
}

<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <title>Dispatch - Deliver DFRNT</title>

    <link id="favicon" rel="icon" type="image/svg+xml" href="/favicon.svg?v=20260619">
    <link rel="alternate icon" type="image/x-icon" href="/dispmain.ico?v=20260619">

    <link rel="preload" as="image" href="/images/dfrnt_logo.png" fetchpriority="high">

    <style>
        /* DFRNT brand hex is inlined rather than tokenised here: this block paints
           before any bundle stylesheet and before app.ts defines the theme vars. */
        :root {
            --theme-primary: #3bc7f4;
            --theme-primary-light: rgba(59, 199, 244, 0.15);
            --theme-primary-medium: rgba(59, 199, 244, 0.3);
            --theme-primary-strong: rgba(59, 199, 244, 0.5);
        }

        html, body {
            background-color: #f4f2f1;
        }

        .app-loader {
            position: fixed;
            inset: 0;
            background-color: #f4f2f1;
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 9999;
            transition: opacity 350ms ease-out;
        }

        .app-loader.hidden {
            opacity: 0;
            pointer-events: none;
        }

        .loader-content {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 24px;
        }

        /* The asset bakes in its own clear-space, so the mark itself renders
           at roughly 214x51 inside this box. */
        .loader-logo {
            width: 260px;
            height: 88px;
            object-fit: contain;
            margin-bottom: 8px;
        }

        .loading-text {
            font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            font-size: 14px;
            font-weight: 400;
            color: #6e6d80;
            letter-spacing: 0.01em;
        }

        .linear-progress {
            width: 200px;
            height: 4px;
            background-color: #e7e5e4;
            border-radius: 9999px;
            overflow: hidden;
            position: relative;
        }

        .linear-progress-bar {
            position: absolute;
            top: 0;
            left: 0;
            height: 100%;
            width: 40%;
            border-radius: 9999px;
            background-color: #3bc7f4;
            animation: indeterminate 1.8s cubic-bezier(0.65, 0.815, 0.735, 0.395) infinite;
        }

        @@keyframes indeterminate {
            0% {
                left: -40%;
                width: 40%;
            }
            60% {
                left: 100%;
                width: 40%;
            }
            100% {
                left: 100%;
                width: 40%;
            }
        }

        @@media (prefers-reduced-motion: reduce) {
            .app-loader {
                transition: none;
            }

            .linear-progress-bar {
                animation: none;
                width: 100%;
                opacity: 0.55;
            }
        }
    </style>

    <script>
        function initMap() {
            console.log("Maps Loaded");
        }
    </script>

    <link rel="stylesheet" href="https://ajax.googleapis.com/ajax/libs/angular_material/1.2.5/angular-material.min.css">
    <link rel="stylesheet" href="https://js.api.here.com/v3/3.1/mapsjs-ui.css"/>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap"/>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    @if (!string.IsNullOrEmpty(vendorCoreCss))
    {
        <link rel="stylesheet" href="/dist/@vendorCoreCss"/>
    }
    @if (!string.IsNullOrEmpty(vendorPluginsCss))
    {
        <link rel="stylesheet" href="/dist/@vendorPluginsCss"/>
    }
    @* Mantine (DFRNT) styles — scoped to @@layer mantine, loaded once for all React islands. *@
    @if (!string.IsNullOrEmpty(vendorReactCss))
    {
        <link rel="stylesheet" href="/dist/@vendorReactCss"/>
    }
    @if (!string.IsNullOrEmpty(appStylesFile))
    {
        <link rel="stylesheet" href="/dist/@appStylesFile"/>
    }
</head>

<body ng-app="uDispatch">
<!-- Full Screen Loader -->
<div class="app-loader" id="appLoader" role="status" aria-live="polite">
    <div class="loader-content">
        <img class="loader-logo" src="/images/dfrnt_logo.png" width="260" height="88" alt="DFRNT">
        <div class="linear-progress" role="progressbar" aria-label="Loading Dispatch">
            <div class="linear-progress-bar"></div>
        </div>
        <div class="loading-text">Loading&hellip;</div>
    </div>
</div>

@RenderBody()

<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.5.1/jquery.min.js"
        integrity="sha512-bLT0Qm9VnAYZDflyKcBaQ2gg0hSYNQrJ8RilYldYQ1FxQYoCLtUjuuRuZo+fjqhx/qtq/1itJ0C2ejDxltZVFg=="
        crossorigin="anonymous" referrerpolicy="no-referrer"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jqueryui/1.12.1/jquery-ui.min.js"
        integrity="sha512-uto9mlQzrs59VwILcLiRYeLKPPbS/bT71da/OEBYEwcdNUk8jYIy+D176RYoop1Da+f9mvkYrmj5MCLZWEtQuA=="
        crossorigin="anonymous" referrerpolicy="no-referrer"></script>

<script src="https://js.api.here.com/v3/3.1/mapsjs-core.js"></script>
<script src="https://js.api.here.com/v3/3.1/mapsjs-core-legacy.js"></script>
<script src="https://js.api.here.com/v3/3.1/mapsjs-service.js"></script>
<script src="https://js.api.here.com/v3/3.1/mapsjs-ui.js"></script>
<script src="https://js.api.here.com/v3/3.1/mapsjs-mapevents.js"></script>
<script src="https://js.api.here.com/v3/3.1/mapsjs-harp.js"></script>

@if (!string.IsNullOrEmpty(vendorCoreJs))
{
    <script src="/dist/@vendorCoreJs"></script>
}
@if (!string.IsNullOrEmpty(vendorPluginsJs))
{
    <script src="/dist/@vendorPluginsJs"></script>
}
@* vendor-react must evaluate before app.js: the module bundles resolve React
   and Mantine off the window globals it publishes. *@
@if (!string.IsNullOrEmpty(vendorReactJs))
{
    <script src="/dist/@vendorReactJs"></script>
}
@if (!string.IsNullOrEmpty(appBundleFile))
{
    <script src="/dist/@appBundleFile"></script>
}


<script>
    (function () {
        var resourcesLoaded = false;
        var angularReady = false;

        setTimeout(function () {
            hideLoader();
        }, 15000);

        function hideLoader() {
            var loaderElement = document.getElementById('appLoader');
            if (loaderElement && !loaderElement.classList.contains('hidden')) {
                loaderElement.classList.add('hidden');

                setTimeout(function () {
                    if (loaderElement.parentNode) {
                        loaderElement.parentNode.removeChild(loaderElement);
                    }
                }, 400);
            }
        }

        window.addEventListener('load', function () {
            resourcesLoaded = true;
            if (angularReady) {
                hideLoader();
            }
        });

        window.angular.module('uDispatch').run(['$timeout', function ($timeout) {
            $timeout(function () {
                angularReady = true;
                if (resourcesLoaded) {
                    hideLoader();
                }
            });
        }]);
    })();
</script>
</body>
</html>
