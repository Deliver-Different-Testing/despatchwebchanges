<!-- Loader Hide Script -->
<script>
    (function() {
        // Track all resources that need to load
        var resourcesLoaded = false;
        var angularReady = false;

        // Set a timeout to hide the loader after a maximum time
        // in case some resources fail to load
        setTimeout(function() {
            hideLoader();
        }, 15000); // 15 seconds maximum waiting time

        // Function to hide the loader
        function hideLoader() {
            var loaderElement = document.getElementById('appLoader');
            if (loaderElement && !loaderElement.classList.contains('hidden')) {
                loaderElement.classList.add('hidden');

                // Remove the loader from DOM after transition completes
                setTimeout(function() {
                    if (loaderElement.parentNode) {
                        loaderElement.parentNode.removeChild(loaderElement);
                    }
                }, 500);
            }
        }

        // Listen for window load event (all resources loaded)
        window.addEventListener('load', function() {
            resourcesLoaded = true;
            if (angularReady) {
                hideLoader();
            }
        });

        // Create an Angular module to run when Angular is ready
        angular.module('uDispatch').run(['$timeout', function($timeout) {
            $timeout(function() {
                angularReady = true;
                if (resourcesLoaded) {
                    hideLoader();
                }
            });
        }]);
    })();
</script>
