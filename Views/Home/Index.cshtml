@{
    ViewData["Title"] = "Home Page";
}
<script>
     @{
         var contactId = ViewBag.ContactID;
         var firstName = ViewBag.FirstName;
         var fullName = ViewBag.FullName;
         var dispatcher = ViewBag.DispatcherName;
         var timezone = ViewBag.TimeZone;
     }

     var ContactID = '@contactId';
     var ClientInternal = @Json.Serialize(ViewBag.ClientInternal ?? false);
     var IsNetworkPartner = @Json.Serialize(ViewBag.IsNetworkPartner ?? false);
     // Dashboards DF Admin has exposed to this session. `null` means "not gated"
     // — see IFeatureVisibilityService. Json.Serialize is required: a bare
     // interpolation ships the array as a string.
     var VisibleFeatures = @Json.Serialize(ViewBag.VisibleFeatures);
     var FirstName = '@firstName';
     var FullName = '@fullName';
     var Dispatcher = '@dispatcher';
     var TimeZone = '@timezone';


</script>
<script>
    var serverConfig = {
        isUSCustomer: @Json.Serialize(ViewBag.IsUsTenant),
        // {lat, lng} for a network partner's own address, otherwise null. Maps
        // that have no explicit centre open here — see getDefaultMapCenter.
        npMapCenter: @Json.Serialize(ViewBag.NpMapCenter)
        };
    window.CurrencyCode = serverConfig.isUSCustomer ? 'USD' : 'NZD';
</script>
<div class="ui-viewer" ui-view>


</div>
