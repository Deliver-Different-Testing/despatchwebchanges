<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <DotNetPlatformVersion>10.0.5</DotNetPlatformVersion>
    <ExcelDataReaderVersion>3.8.0</ExcelDataReaderVersion>
    <MockQueryableVersion>10.0.2</MockQueryableVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Amazon.AspNetCore.DataProtection.SSM" Version="4.0.1" />
    <PackageVersion Include="Anthropic" Version="12.8.0" />
    <PackageVersion Include="AspNetCore.HealthChecks.SqlServer" Version="9.0.0" />
    <PackageVersion Include="AWSSDK.S3" Version="4.0.19" />
    <PackageVersion Include="AWSSDK.SecurityToken" Version="4.0.5.12" />
    <PackageVersion Include="AWSSDK.SSO" Version="4.0.2.16" />
    <PackageVersion Include="coverlet.collector" Version="8.0.0" />
    <PackageVersion Include="Dapper" Version="2.1.72" />
    <PackageVersion Include="DeliverDifferentReporting" Version="1.1.0" />
    <PackageVersion Include="ExcelDataReader" Version="$(ExcelDataReaderVersion)" />
    <PackageVersion Include="ExcelDataReader.DataSet" Version="$(ExcelDataReaderVersion)" />
    <PackageVersion Include="FluentAssertions" Version="8.8.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" Version="$(DotNetPlatformVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="$(DotNetPlatformVersion)" />
    <PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="4.14.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="$(DotNetPlatformVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="$(DotNetPlatformVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="$(DotNetPlatformVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="$(DotNetPlatformVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="$(DotNetPlatformVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="$(DotNetPlatformVersion)" />
    <PackageVersion Include="MockQueryable.Core" Version="$(MockQueryableVersion)" />
    <PackageVersion Include="MockQueryable.EntityFrameworkCore" Version="$(MockQueryableVersion)" />
    <PackageVersion Include="MockQueryable.Moq" Version="$(MockQueryableVersion)" />
    <PackageVersion Include="Moq" Version="4.20.72" />
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageVersion Include="System.Linq.Async" Version="7.0.0" />
    <PackageVersion Include="System.Linq.Dynamic.Core" Version="1.7.1" />
    <PackageVersion Include="TimeZoneConverter" Version="7.2.0" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
  </ItemGroup>
</Project>
