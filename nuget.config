<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="gitlab" value="https://gitlab.com/api/v4/projects/87230617/packages/nuget/index.json" />
    <add key="gitlab-agentaccess" value="https://gitlab.com/api/v4/projects/87595416/packages/nuget/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="gitlab">
      <package pattern="DeliverDifferentReporting" />
    </packageSource>
    <packageSource key="gitlab-agentaccess">
      <package pattern="DeliverDifferent.AgentAccess" />
    </packageSource>
  </packageSourceMapping>
  <packageSourceCredentials>
    <gitlab>
      <add key="Username" value="%GITLAB_NUGET_USERNAME%" />
      <add key="ClearTextPassword" value="%GITLAB_NUGET_TOKEN%" />
    </gitlab>
    <gitlab-agentaccess>
      <add key="Username" value="%GITLAB_NUGET_USERNAME%" />
      <add key="ClearTextPassword" value="%GITLAB_NUGET_TOKEN%" />
    </gitlab-agentaccess>
  </packageSourceCredentials>
</configuration>
