{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "incremental": true,
    "tsBuildInfoFile": ".tsbuildinfo",
    "allowSyntheticDefaultImports": true,
    "allowUmdGlobalAccess": true,
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "typeRoots": [
      "./node_modules/@types"
    ],
    "types": [
      "jest",
      "node",
      "angular",
      "angular-material",
      "angular-ui-router",
      "angular-ui-sortable",
      "oclazyload",
      "modernizr"
    ]
  },
  "include": [
    "wwwroot/**/*.ts",
    "wwwroot/**/*.tsx",
    "wwwroot/types/*.d.ts",
    "scripts/**/*.ts",
    "*.ts"
  ]
}
